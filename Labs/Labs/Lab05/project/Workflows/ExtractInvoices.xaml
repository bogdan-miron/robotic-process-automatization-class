  <Sequence DisplayName="Extract the invoices" sap2010:Annotation.AnnotationText="One PDF after the other. A file that is not an invoice is skipped and listed, the rest goes on.">
    <Sequence.Variables>
      <Variable x:TypeArguments="s:String[]" Name="files" />
      <Variable x:TypeArguments="x:String" Name="invoiceNo" />
      <Variable x:TypeArguments="x:String" Name="invoiceDate" />
      <Variable x:TypeArguments="x:String" Name="client" />
      <Variable x:TypeArguments="x:String" Name="country" />
      <Variable x:TypeArguments="x:Double" Name="amount" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:BuildDataTable DisplayName="Build Data Table: invoices" DataTable="[out_Invoices]" TableInfo="&lt;NewDataSet&gt;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;TableName&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xA;      &lt;xs:complexType&gt;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xA;          &lt;xs:element name=&quot;TableName&quot;&gt;&#xA;            &lt;xs:complexType&gt;&#xA;              &lt;xs:sequence&gt;&#xA;                &lt;xs:element name=&quot;InvoiceNo&quot; msdata:Caption=&quot;&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Date&quot; msdata:Caption=&quot;&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Client&quot; msdata:Caption=&quot;&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Country&quot; msdata:Caption=&quot;&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Amount&quot; msdata:Caption=&quot;&quot; type=&quot;xs:double&quot; minOccurs=&quot;0&quot; /&gt;&#xA;              &lt;/xs:sequence&gt;&#xA;            &lt;/xs:complexType&gt;&#xA;          &lt;/xs:element&gt;&#xA;        &lt;/xs:choice&gt;&#xA;      &lt;/xs:complexType&gt;&#xA;    &lt;/xs:element&gt;&#xA;  &lt;/xs:schema&gt;&#xA;&lt;/NewDataSet&gt;" />
    <Assign DisplayName="List the PDF files">
      <Assign.To>
        <OutArgument x:TypeArguments="s:String[]">[files]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="s:String[]">[System.IO.Directory.GetFiles(in_Folder, "*.pdf")]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:ForEach DisplayName="For each PDF file" x:TypeArguments="x:String" CurrentIndex="{x:Null}" Values="[files]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="pdfPath" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <TryCatch DisplayName="Try Catch: one invoice">
              <TryCatch.Try>
                <Sequence DisplayName="Try">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <ui:InvokeWorkflowFile DisplayName="Invoke ReadInvoicePdf" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\ReadInvoicePdf.xaml">
                    <ui:InvokeWorkflowFile.Arguments>
                      <InArgument x:TypeArguments="x:String" x:Key="in_PdfPath">[pdfPath]</InArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="out_InvoiceNo">[invoiceNo]</OutArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="out_InvoiceDate">[invoiceDate]</OutArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="out_Client">[client]</OutArgument>
                      <OutArgument x:TypeArguments="x:Double" x:Key="out_Amount">[amount]</OutArgument>
                    </ui:InvokeWorkflowFile.Arguments>
                  </ui:InvokeWorkflowFile>
                  <Assign DisplayName="Look up the country">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[country]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[If(in_Countries.ContainsKey(client), in_Countries(client), "Unknown")]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <ui:AddDataRow DisplayName="Add Data Row: invoice" DataRow="{x:Null}" ArrayRow="[New Object() {invoiceNo, invoiceDate, client, country, amount}]" DataTable="[out_Invoices]" />
                </Sequence>
              </TryCatch.Try>
              <TryCatch.Catches>
                <Catch x:TypeArguments="ui:BusinessRuleException">
                  <ActivityAction x:TypeArguments="ui:BusinessRuleException">
                    <ActivityAction.Argument>
                      <DelegateInArgument x:TypeArguments="ui:BusinessRuleException" Name="brex" />
                    </ActivityAction.Argument>
                    <Sequence DisplayName="Catch BusinessRuleException">
                      <sap:WorkflowViewStateService.ViewState>
                        <scg:Dictionary x:TypeArguments="x:String, x:Object">
                          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                        </scg:Dictionary>
                      </sap:WorkflowViewStateService.ViewState>
                      <ui:LogMessage DisplayName="Log the skipped file" Level="Warn" Message="[&quot;Skipped: &quot; &amp; brex.Message]" />
                      <InvokeMethod DisplayName="Remember the skipped file" MethodName="Add">
                        <InvokeMethod.TargetObject>
                          <InArgument x:TypeArguments="scg:List(x:String)">[io_Skipped]</InArgument>
                        </InvokeMethod.TargetObject>
                        <InArgument x:TypeArguments="x:String">[System.IO.Path.GetFileName(pdfPath) &amp; ": " &amp; brex.Message]</InArgument>
                      </InvokeMethod>
                    </Sequence>
                  </ActivityAction>
                </Catch>
              </TryCatch.Catches>
            </TryCatch>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:SortDataTable DisplayName="Sort Data Table by InvoiceNo" ColumnIndex="{x:Null}" DataColumn="{x:Null}" ColumnName="InvoiceNo" DataTable="[out_Invoices]" Order="Ascending" OutputDataTable="[out_Invoices]" SortOrder="Ascending" />
    <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[&quot;Extracted &quot; &amp; out_Invoices.Rows.Count &amp; &quot; invoices, skipped &quot; &amp; io_Skipped.Count]" />
  </Sequence>
</Activity>
