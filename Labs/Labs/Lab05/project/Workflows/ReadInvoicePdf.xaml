  <Sequence DisplayName="Read one invoice" sap2010:Annotation.AnnotationText="Read PDF Text returns the text of the page. Regular expressions pick the fields. A file without them breaks a business rule.">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="pdfText" />
      <Variable x:TypeArguments="x:String" Name="amountText" />
      <Variable x:TypeArguments="x:String" Name="missing" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:ReadPDFText DisplayName="Read PDF Text" FileName="[in_PdfPath]" Range="[&quot;All&quot;]" Text="[pdfText]" />
    <Assign DisplayName="Find the invoice number">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_InvoiceNo]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Match(pdfText, "Invoice No:\s*(\S+)").Groups(1).Value]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Find the date">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_InvoiceDate]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Match(pdfText, "Date:\s*(\d{4}-\d{2}-\d{2})").Groups(1).Value]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Find the client">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_Client]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Match(pdfText, "Client:[ \t]*([^\r\n]+)").Groups(1).Value.Trim()]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Find the total">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[amountText]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Match(pdfText, "Total:\s*([0-9]+(?:\.[0-9]{1,2})?)").Groups(1).Value]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Collect the missing fields">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[missing]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[If(out_InvoiceNo = "", "invoice number; ", "") &amp; If(out_InvoiceDate = "", "date; ", "") &amp; If(out_Client = "", "client; ", "") &amp; If(amountText = "", "total; ", "")]</InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="Business rule: all fields found" Condition="[missing &lt;&gt; &quot;&quot;]">
      <If.Then>
        <Sequence DisplayName="Then">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Throw DisplayName="Throw: not an invoice" Exception="[New BusinessRuleException(&quot;The file &quot; &amp; System.IO.Path.GetFileName(in_PdfPath) &amp; &quot; is not a valid invoice, missing: &quot; &amp; missing)]" />
        </Sequence>
      </If.Then>
    </If>
    <Assign DisplayName="Convert the total to a number">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Double">[out_Amount]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Double">[Double.Parse(amountText, System.Globalization.CultureInfo.InvariantCulture)]</InArgument>
      </Assign.Value>
    </Assign>
  </Sequence>
</Activity>
