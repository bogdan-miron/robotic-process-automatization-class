  <Sequence DisplayName="Load the clients" sap2010:Annotation.AnnotationText="Read CSV gives a DataTable. The rows become a dictionary Client -&gt; Country.">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="clients" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Assign DisplayName="Create the dictionary">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[out_Countries]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[New Dictionary(Of String, String)]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:ReadCsvFile DisplayName="Read CSV: clients" DataTable="[clients]" FilePath="[in_ClientsCsv]" />
    <ui:ForEachRow DisplayName="For each client row" ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[clients]">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <If DisplayName="If the client is new" Condition="[Not out_Countries.ContainsKey(CurrentRow(&quot;Client&quot;).ToString().Trim())]">
              <If.Then>
                <Sequence DisplayName="Then">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <InvokeMethod DisplayName="Add client and country" MethodName="Add">
                    <InvokeMethod.TargetObject>
                      <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[out_Countries]</InArgument>
                    </InvokeMethod.TargetObject>
                    <InArgument x:TypeArguments="x:String">[CurrentRow("Client").ToString().Trim()]</InArgument>
                    <InArgument x:TypeArguments="x:String">[CurrentRow("Country").ToString().Trim()]</InArgument>
                  </InvokeMethod>
                </Sequence>
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[&quot;Loaded &quot; &amp; out_Countries.Count &amp; &quot; clients from &quot; &amp; in_ClientsCsv]" />
  </Sequence>
</Activity>
