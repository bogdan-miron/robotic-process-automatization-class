  <Sequence DisplayName="Process the invoices" sap2010:Annotation.AnnotationText="Reads the first Excel file, filters and sorts, and writes the second Excel file with two sheets. The cells read from Excel are objects, so the rows are copied into a table with real column types first.">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="raw" />
      <Variable x:TypeArguments="sd:DataTable" Name="typed" />
      <Variable x:TypeArguments="sd:DataTable" Name="large" />
      <Variable x:TypeArguments="sd:DataTable" Name="totals" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Double)" Name="clientTotals" Default="[New Dictionary(Of String, Double)]" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Int32)" Name="clientCounts" Default="[New Dictionary(Of String, Int32)]" />
      <Variable x:TypeArguments="x:String" Name="client" />
      <Variable x:TypeArguments="x:Double" Name="amount" />
      <Variable x:TypeArguments="x:Double" Name="newTotal" />
      <Variable x:TypeArguments="x:Int32" Name="newCount" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:ReadRange DisplayName="Read Range: all invoices" AddHeaders="True" DataTable="[raw]" SheetName="[&quot;Invoices&quot;]" WorkbookPath="[in_InvoicesPath]" />
    <ui:BuildDataTable DisplayName="Build Data Table: typed invoices" DataTable="[typed]" TableInfo="&lt;NewDataSet&gt;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;TableName&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xA;      &lt;xs:complexType&gt;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xA;          &lt;xs:element name=&quot;TableName&quot;&gt;&#xA;            &lt;xs:complexType&gt;&#xA;              &lt;xs:sequence&gt;&#xA;                &lt;xs:element name=&quot;InvoiceNo&quot; msdata:Caption=&quot;&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Date&quot; msdata:Caption=&quot;&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Client&quot; msdata:Caption=&quot;&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Country&quot; msdata:Caption=&quot;&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Amount&quot; msdata:Caption=&quot;&quot; type=&quot;xs:double&quot; minOccurs=&quot;0&quot; /&gt;&#xA;              &lt;/xs:sequence&gt;&#xA;            &lt;/xs:complexType&gt;&#xA;          &lt;/xs:element&gt;&#xA;        &lt;/xs:choice&gt;&#xA;      &lt;/xs:complexType&gt;&#xA;    &lt;/xs:element&gt;&#xA;  &lt;/xs:schema&gt;&#xA;&lt;/NewDataSet&gt;" />
    <ui:ForEachRow DisplayName="For each row read from Excel" ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[raw]">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <ui:AddDataRow DisplayName="Add Data Row: typed" DataRow="{x:Null}" ArrayRow="[New Object() {CurrentRow(&quot;InvoiceNo&quot;).ToString(), CurrentRow(&quot;Date&quot;).ToString(), CurrentRow(&quot;Client&quot;).ToString(), CurrentRow(&quot;Country&quot;).ToString(), CDbl(CurrentRow(&quot;Amount&quot;))}]" DataTable="[typed]" />
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <Assign DisplayName="Assign out_AllCount">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[out_AllCount]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[typed.Rows.Count]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:InvokeWorkflowFile DisplayName="Invoke FilterInvoices" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\FilterInvoices.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_Table">[typed]</InArgument>
        <InArgument x:TypeArguments="x:Double" x:Key="in_MinAmount">[in_MinAmount]</InArgument>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_Filtered">[large]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:SortDataTable DisplayName="Sort Data Table by Amount, largest first" ColumnIndex="{x:Null}" DataColumn="{x:Null}" ColumnName="Amount" DataTable="[large]" Order="Descending" OutputDataTable="[large]" SortOrder="Descending" />
    <Assign DisplayName="Assign out_LargeCount">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[out_LargeCount]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[large.Rows.Count]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign clientTotals">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Double)">[clientTotals]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Double)">[New Dictionary(Of String, Double)]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign clientCounts">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[clientCounts]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[New Dictionary(Of String, Int32)]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:ForEachRow DisplayName="For each invoice: total per client" ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[typed]">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <Assign DisplayName="Assign client">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[client]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[CurrentRow("Client").ToString()]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Assign amount">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Double">[amount]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Double">[CDbl(CurrentRow("Amount"))]</InArgument>
              </Assign.Value>
            </Assign>
            <If DisplayName="If the client was seen before" Condition="[Not clientTotals.ContainsKey(client)]">
              <If.Then>
                <Sequence DisplayName="Then">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <InvokeMethod DisplayName="First invoice of the client" MethodName="Add">
                    <InvokeMethod.TargetObject>
                      <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Double)">[clientTotals]</InArgument>
                    </InvokeMethod.TargetObject>
                    <InArgument x:TypeArguments="x:String">[client]</InArgument>
                    <InArgument x:TypeArguments="x:Double">[amount]</InArgument>
                  </InvokeMethod>
                  <InvokeMethod DisplayName="Count 1" MethodName="Add">
                    <InvokeMethod.TargetObject>
                      <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[clientCounts]</InArgument>
                    </InvokeMethod.TargetObject>
                    <InArgument x:TypeArguments="x:String">[client]</InArgument>
                    <InArgument x:TypeArguments="x:Int32">[1]</InArgument>
                  </InvokeMethod>
                </Sequence>
              </If.Then>
              <If.Else>
                <Sequence DisplayName="Else">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <Assign DisplayName="Assign newTotal">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Double">[newTotal]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Double">[clientTotals(client) + amount]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <Assign DisplayName="Assign newCount">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Int32">[newCount]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Int32">[clientCounts(client) + 1]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <InvokeMethod DisplayName="Remove the old total" MethodName="Remove">
                    <InvokeMethod.TargetObject>
                      <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Double)">[clientTotals]</InArgument>
                    </InvokeMethod.TargetObject>
                    <InArgument x:TypeArguments="x:String">[client]</InArgument>
                  </InvokeMethod>
                  <InvokeMethod DisplayName="Store the new total" MethodName="Add">
                    <InvokeMethod.TargetObject>
                      <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Double)">[clientTotals]</InArgument>
                    </InvokeMethod.TargetObject>
                    <InArgument x:TypeArguments="x:String">[client]</InArgument>
                    <InArgument x:TypeArguments="x:Double">[newTotal]</InArgument>
                  </InvokeMethod>
                  <InvokeMethod DisplayName="Remove the old count" MethodName="Remove">
                    <InvokeMethod.TargetObject>
                      <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[clientCounts]</InArgument>
                    </InvokeMethod.TargetObject>
                    <InArgument x:TypeArguments="x:String">[client]</InArgument>
                  </InvokeMethod>
                  <InvokeMethod DisplayName="Store the new count" MethodName="Add">
                    <InvokeMethod.TargetObject>
                      <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[clientCounts]</InArgument>
                    </InvokeMethod.TargetObject>
                    <InArgument x:TypeArguments="x:String">[client]</InArgument>
                    <InArgument x:TypeArguments="x:Int32">[newCount]</InArgument>
                  </InvokeMethod>
                </Sequence>
              </If.Else>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <ui:BuildDataTable DisplayName="Build Data Table: totals" DataTable="[totals]" TableInfo="&lt;NewDataSet&gt;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;TableName&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xA;      &lt;xs:complexType&gt;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xA;          &lt;xs:element name=&quot;TableName&quot;&gt;&#xA;            &lt;xs:complexType&gt;&#xA;              &lt;xs:sequence&gt;&#xA;                &lt;xs:element name=&quot;Client&quot; msdata:Caption=&quot;&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Invoices&quot; msdata:Caption=&quot;&quot; type=&quot;xs:int&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Total&quot; msdata:Caption=&quot;&quot; type=&quot;xs:double&quot; minOccurs=&quot;0&quot; /&gt;&#xA;              &lt;/xs:sequence&gt;&#xA;            &lt;/xs:complexType&gt;&#xA;          &lt;/xs:element&gt;&#xA;        &lt;/xs:choice&gt;&#xA;      &lt;/xs:complexType&gt;&#xA;    &lt;/xs:element&gt;&#xA;  &lt;/xs:schema&gt;&#xA;&lt;/NewDataSet&gt;" />
    <ui:ForEach DisplayName="For each client" x:TypeArguments="scg:KeyValuePair(x:String, x:Double)" CurrentIndex="{x:Null}" Values="[clientTotals]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="scg:KeyValuePair(x:String, x:Double)">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="scg:KeyValuePair(x:String, x:Double)" Name="entry" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <ui:AddDataRow DisplayName="Add Data Row: client total" DataRow="{x:Null}" ArrayRow="[New Object() {entry.Key, clientCounts(entry.Key), Math.Round(entry.Value, 2)}]" DataTable="[totals]" />
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:SortDataTable DisplayName="Sort Data Table by Total, largest first" ColumnIndex="{x:Null}" DataColumn="{x:Null}" ColumnName="Total" DataTable="[totals]" Order="Descending" OutputDataTable="[totals]" SortOrder="Descending" />
    <ui:InvokeWorkflowFile DisplayName="Invoke WriteTableToExcel: large invoices" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\WriteTableToExcel.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_Table">[large]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_WorkbookPath">[in_ReportPath]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Sheet">["Large invoices"]</InArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:InvokeWorkflowFile DisplayName="Invoke WriteTableToExcel: totals" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\WriteTableToExcel.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_Table">[totals]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_WorkbookPath">[in_ReportPath]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Sheet">["Totals per client"]</InArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
  </Sequence>
</Activity>
