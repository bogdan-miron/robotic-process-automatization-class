      <Variable x:TypeArguments="x:String" Name="difficulty" />
      <Variable x:TypeArguments="x:String" Name="answer" />
      <Variable x:TypeArguments="x:String" Name="guessText" />
      <Variable x:TypeArguments="x:String" Name="summary" />
      <Variable x:TypeArguments="s:String[]" Name="levels" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Int32)" Name="ranges" Default="[New Dictionary(Of String, Int32)]" />
      <Variable x:TypeArguments="scg:List(x:Int32)" Name="history" Default="[New List(Of Int32)]" />
      <Variable x:TypeArguments="x:Int32" Name="maxNumber" />
      <Variable x:TypeArguments="x:Int32" Name="secretNumber" />
