    <Sequence DisplayName="1. Setup" sap2010:Annotation.AnnotationText="Collections: an array with the level names, a dictionary level -&gt; largest number.">
      <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
      <Assign DisplayName="Assign levels (array)">
        <Assign.To>
          <OutArgument x:TypeArguments="s:String[]">[levels]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="s:String[]">[New String() {"Easy", "Medium", "Hard"}]</InArgument>
        </Assign.Value>
      </Assign>
      <InvokeMethod DisplayName="Range Easy = 10" MethodName="Add">
        <InvokeMethod.TargetObject>
          <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[ranges]</InArgument>
        </InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="x:String">["Easy"]</InArgument>
        <InArgument x:TypeArguments="x:Int32">[10]</InArgument>
      </InvokeMethod>
      <InvokeMethod DisplayName="Range Medium = 50" MethodName="Add">
        <InvokeMethod.TargetObject>
          <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[ranges]</InArgument>
        </InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="x:String">["Medium"]</InArgument>
        <InArgument x:TypeArguments="x:Int32">[50]</InArgument>
      </InvokeMethod>
      <InvokeMethod DisplayName="Range Hard = 100" MethodName="Add">
        <InvokeMethod.TargetObject>
          <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[ranges]</InArgument>
        </InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="x:String">["Hard"]</InArgument>
        <InArgument x:TypeArguments="x:Int32">[100]</InArgument>
      </InvokeMethod>
      <ui:InputDialog DisplayName="Ask for the player name" Options="{x:Null}" OptionsString="{x:Null}" Title="Guess the number" IsPassword="False" Label="[&quot;What is your name?&quot;]">
        <ui:InputDialog.Result>
          <OutArgument x:TypeArguments="x:String">[playerName]</OutArgument>
        </ui:InputDialog.Result>
      </ui:InputDialog>
      <If DisplayName="If the name is empty" Condition="[playerName Is Nothing OrElse playerName.Trim() = &quot;&quot;]">
        <If.Then>
          <Sequence DisplayName="Then">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <Assign DisplayName="Assign playerName">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[playerName]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">["Player"]</InArgument>
              </Assign.Value>
            </Assign>
          </Sequence>
        </If.Then>
      </If>
      <Assign DisplayName="Assign playAgain">
        <Assign.To>
          <OutArgument x:TypeArguments="x:Boolean">[playAgain]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
        </Assign.Value>
      </Assign>
    </Sequence>
    <While DisplayName="While the player wants to play" sap2010:Annotation.AnnotationText="Control flow: While repeats rounds, For Each walks the history, the flowchart loops on wrong guesses." Condition="[playAgain]">
