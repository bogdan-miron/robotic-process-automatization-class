  <Sequence DisplayName="Task C: guess the number (1 to 7)">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="nr" />
      <Variable x:TypeArguments="x:Int32" Name="g" />
      <Variable x:TypeArguments="x:String" Name="gText" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Assign DisplayName="Generate nr from 1 to 7" sap2010:Annotation.AnnotationText="Random.Next(1, 8) returns 1..7, the upper bound is excluded.">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[nr]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[New Random().Next(1, 8)]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:InputDialog DisplayName="Read the first guess" Options="{x:Null}" OptionsString="{x:Null}" Title="Guess the number" IsPassword="False" Label="[&quot;Guess the number (1 to 7)&quot;]">
      <ui:InputDialog.Result>
        <OutArgument x:TypeArguments="x:String">[gText]</OutArgument>
      </ui:InputDialog.Result>
    </ui:InputDialog>
    <Assign DisplayName="Convert the guess to a number">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[g]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[If(gText IsNot Nothing AndAlso gText.Trim().Length &gt; 0 AndAlso gText.Trim().Length &lt; 7 AndAlso Not (gText.Trim() Like "*[!0-9]*"), CInt(gText.Trim()), 0)]</InArgument>
      </Assign.Value>
    </Assign>
    <While DisplayName="Repeat until g = nr" Condition="[g &lt;&gt; nr]">
      <While.Body>
        <Sequence DisplayName="Body">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <If DisplayName="If g is greater than nr" Condition="[g &gt; nr]">
            <If.Then>
              <Sequence DisplayName="Then">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <ui:MessageBox DisplayName="Message Box" Caption="Guess the number" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" Text="[&quot;Enter a smaller number!&quot;]" />
              </Sequence>
            </If.Then>
            <If.Else>
              <Sequence DisplayName="Else">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <ui:MessageBox DisplayName="Message Box" Caption="Guess the number" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" Text="[&quot;Enter a bigger number!&quot;]" />
              </Sequence>
            </If.Else>
          </If>
          <ui:InputDialog DisplayName="Read the next guess" Options="{x:Null}" OptionsString="{x:Null}" Title="Guess the number" IsPassword="False" Label="[&quot;Guess the number (1 to 7)&quot;]">
            <ui:InputDialog.Result>
              <OutArgument x:TypeArguments="x:String">[gText]</OutArgument>
            </ui:InputDialog.Result>
          </ui:InputDialog>
          <Assign DisplayName="Convert the guess to a number">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[g]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[If(gText IsNot Nothing AndAlso gText.Trim().Length &gt; 0 AndAlso gText.Trim().Length &lt; 7 AndAlso Not (gText.Trim() Like "*[!0-9]*"), CInt(gText.Trim()), 0)]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </While.Body>
    </While>
    <ui:MessageBox DisplayName="Message Box" Caption="Guess the number" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" Text="[&quot;Well done!!!&quot;]" />
  </Sequence>
</Activity>
