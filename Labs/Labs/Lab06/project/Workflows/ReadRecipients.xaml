  <Sequence DisplayName="Read recipients.xlsx" sap2010:Annotation.AnnotationText="Read Range puts the sheet into a DataTable. The sheet needs a header row: Name, Email, Attachment.">
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:ReadRange DisplayName="Read Range: recipients" AddHeaders="True" DataTable="[out_Recipients]" SheetName="[&quot;Recipients&quot;]" WorkbookPath="[in_Path]" />
    <If DisplayName="Business rule: the three columns exist" Condition="[Not (out_Recipients.Columns.Contains(&quot;Name&quot;) AndAlso out_Recipients.Columns.Contains(&quot;Email&quot;) AndAlso out_Recipients.Columns.Contains(&quot;Attachment&quot;))]">
      <If.Then>
        <Sequence DisplayName="Then">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Throw DisplayName="Throw: wrong columns" Exception="[New BusinessRuleException(&quot;The recipients file needs the columns Name, Email and Attachment.&quot;)]" />
        </Sequence>
      </If.Then>
    </If>
    <If DisplayName="Business rule: at least one recipient" Condition="[out_Recipients.Rows.Count = 0]">
      <If.Then>
        <Sequence DisplayName="Then">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Throw DisplayName="Throw: no recipients" Exception="[New BusinessRuleException(&quot;The recipients file has no rows.&quot;)]" />
        </Sequence>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[&quot;Read &quot; &amp; out_Recipients.Rows.Count &amp; &quot; recipients from &quot; &amp; in_Path]" />
  </Sequence>
