    <ui:ForEachRow DisplayName="For each recipient" ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[in_Recipients]">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <Assign DisplayName="Assign name">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[name]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[CurrentRow("Name").ToString().Trim()]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Assign email">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[email]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[CurrentRow("Email").ToString().Trim()]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Assign attachment">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[attachment]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[CurrentRow("Attachment").ToString().Trim()]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Assign status">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[status]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[""]</InArgument>
              </Assign.Value>
            </Assign>
            <TryCatch DisplayName="Try Catch: one recipient" sap2010:Annotation.AnnotationText="Business rule exception: the row is wrong, it is skipped. Any other exception (server, network): the row is marked failed and the next one goes on.">
              <TryCatch.Try>
                <Sequence DisplayName="Try">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <If DisplayName="Business rule: valid address" Condition="[Not System.Text.RegularExpressions.Regex.IsMatch(email, &quot;^[^@\s]+@[^@\s]+\.[^@\s]+$&quot;)]">
                    <If.Then>
                      <Sequence DisplayName="Then">
                        <sap:WorkflowViewStateService.ViewState>
                          <scg:Dictionary x:TypeArguments="x:String, x:Object">
                            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                          </scg:Dictionary>
                        </sap:WorkflowViewStateService.ViewState>
                        <Throw DisplayName="Throw: invalid address" Exception="[New BusinessRuleException(&quot;the address &quot; &amp; email &amp; &quot; is not valid&quot;)]" />
                      </Sequence>
                    </If.Then>
                  </If>
                  <If DisplayName="Business rule: an attachment is named" Condition="[attachment = &quot;&quot;]">
                    <If.Then>
                      <Sequence DisplayName="Then">
                        <sap:WorkflowViewStateService.ViewState>
                          <scg:Dictionary x:TypeArguments="x:String, x:Object">
                            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                          </scg:Dictionary>
                        </sap:WorkflowViewStateService.ViewState>
                        <Throw DisplayName="Throw: no attachment named" Exception="[New BusinessRuleException(&quot;no attachment is named for &quot; &amp; name)]" />
                      </Sequence>
                    </If.Then>
                  </If>
                  <Assign DisplayName="Assign attachmentPath">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[attachmentPath]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[System.IO.Path.Combine(in_AttachmentsFolder, attachment)]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <If DisplayName="Business rule: the attachment exists" Condition="[Not System.IO.File.Exists(attachmentPath)]">
                    <If.Then>
                      <Sequence DisplayName="Then">
                        <sap:WorkflowViewStateService.ViewState>
                          <scg:Dictionary x:TypeArguments="x:String, x:Object">
                            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                          </scg:Dictionary>
                        </sap:WorkflowViewStateService.ViewState>
                        <Throw DisplayName="Throw: attachment not found" Exception="[New BusinessRuleException(&quot;the attachment &quot; &amp; attachment &amp; &quot; does not exist&quot;)]" />
                      </Sequence>
                    </If.Then>
                  </If>
                  <If DisplayName="If this is a dry run" Condition="[in_DryRun]">
                    <If.Then>
                      <Sequence DisplayName="Then">
                        <sap:WorkflowViewStateService.ViewState>
                          <scg:Dictionary x:TypeArguments="x:String, x:Object">
                            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                          </scg:Dictionary>
                        </sap:WorkflowViewStateService.ViewState>
                        <ui:LogMessage DisplayName="Log the dry run" Level="Info" Message="[&quot;DRY RUN: would send &quot; &amp; attachment &amp; &quot; to &quot; &amp; email]" />
                        <Assign DisplayName="Assign status">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:String">[status]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:String">["Dry run, not sent"]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </Sequence>
                    </If.Then>
                    <If.Else>
                      <Sequence DisplayName="Else">
                        <sap:WorkflowViewStateService.ViewState>
                          <scg:Dictionary x:TypeArguments="x:String, x:Object">
                            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                          </scg:Dictionary>
                        </sap:WorkflowViewStateService.ViewState>
                        <ui:RetryScope DisplayName="Retry Scope: send the mail" sap2010:Annotation.AnnotationText="A temporary server problem is tried again, up to 3 times, 5 seconds apart." NumberOfRetries="3" RetryInterval="00:00:05">
                          <ui:RetryScope.ActivityBody>
                            <ActivityAction>
                              <Sequence DisplayName="Action">
                                <sap:WorkflowViewStateService.ViewState>
                                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                                  </scg:Dictionary>
                                </sap:WorkflowViewStateService.ViewState>
                                <ui:SendMail DisplayName="Send SMTP Mail Message" Body="[&quot;Hello &quot; &amp; name &amp; &quot;,&quot; &amp; Environment.NewLine &amp; Environment.NewLine &amp; &quot;Your report is attached.&quot; &amp; Environment.NewLine &amp; Environment.NewLine &amp; &quot;Kind regards&quot;]" Email="[in_Settings(&quot;Sender&quot;)]" Files="[New String() {attachmentPath}]" Password="[in_Password]" Port="[CInt(in_Settings(&quot;SmtpPort&quot;))]" SecureConnection="Auto" Server="[in_Settings(&quot;SmtpServer&quot;)]" Subject="[&quot;Your report&quot;]" To="[email]" />
                              </Sequence>
                            </ActivityAction>
                          </ui:RetryScope.ActivityBody>
                          <ui:RetryScope.Condition>
                            <ActivityFunc x:TypeArguments="x:Boolean" />
                          </ui:RetryScope.Condition>
                        </ui:RetryScope>
                        <ui:LogMessage DisplayName="Log the sent mail" Level="Info" Message="[&quot;Sent &quot; &amp; attachment &amp; &quot; to &quot; &amp; email]" />
                        <Assign DisplayName="Assign status">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:String">[status]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:String">["Sent"]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </Sequence>
                    </If.Else>
                  </If>
                  <Assign DisplayName="Assign out_Sent">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Int32">[out_Sent]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Int32">[out_Sent + 1]</InArgument>
                    </Assign.Value>
                  </Assign>
                </Sequence>
              </TryCatch.Try>
              <TryCatch.Catches>
                <Catch x:TypeArguments="ui:BusinessRuleException">
                  <ActivityAction x:TypeArguments="ui:BusinessRuleException">
                    <ActivityAction.Argument>
                      <DelegateInArgument x:TypeArguments="ui:BusinessRuleException" Name="brex" />
                    </ActivityAction.Argument>
                    <Sequence DisplayName="Catch BusinessRuleException">
                      <sap:WorkflowViewStateService.ViewState>
                        <scg:Dictionary x:TypeArguments="x:String, x:Object">
                          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                        </scg:Dictionary>
                      </sap:WorkflowViewStateService.ViewState>
                      <Assign DisplayName="Assign status">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[status]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">["Skipped: " &amp; brex.Message]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign DisplayName="Assign out_Skipped">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Int32">[out_Skipped]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Int32">[out_Skipped + 1]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <ui:LogMessage DisplayName="Log the skipped row" Level="Warn" Message="[&quot;Skipped &quot; &amp; name &amp; &quot;: &quot; &amp; brex.Message]" />
                    </Sequence>
                  </ActivityAction>
                </Catch>
                <Catch x:TypeArguments="s:Exception">
                  <ActivityAction x:TypeArguments="s:Exception">
                    <ActivityAction.Argument>
                      <DelegateInArgument x:TypeArguments="s:Exception" Name="ex" />
                    </ActivityAction.Argument>
                    <Sequence DisplayName="Catch Exception">
                      <sap:WorkflowViewStateService.ViewState>
                        <scg:Dictionary x:TypeArguments="x:String, x:Object">
                          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                        </scg:Dictionary>
                      </sap:WorkflowViewStateService.ViewState>
                      <Assign DisplayName="Assign status">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[status]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">["Failed: " &amp; ex.Message]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign DisplayName="Assign out_Failed">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Int32">[out_Failed]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Int32">[out_Failed + 1]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <ui:LogMessage DisplayName="Log the failed row" Level="Error" Message="[&quot;Failed &quot; &amp; name &amp; &quot;: &quot; &amp; ex.Message]" />
                    </Sequence>
                  </ActivityAction>
                </Catch>
              </TryCatch.Catches>
            </TryCatch>
            <ui:AddDataRow DisplayName="Add Data Row: result of this recipient" DataRow="{x:Null}" ArrayRow="[New Object() {name, email, attachment, status, DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)}]" DataTable="[out_Results]" />
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
  </Sequence>
</Activity>
