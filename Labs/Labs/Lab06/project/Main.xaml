  <Sequence DisplayName="Lab06: Send e-mails with attachments from an Excel file" sap2010:Annotation.AnnotationText="Main only coordinates. The password is asked when the e-mails are really sent. It is not stored in any file.">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="settingsPath" />
      <Variable x:TypeArguments="x:String" Name="recipientsPath" />
      <Variable x:TypeArguments="x:String" Name="attachmentsFolder" />
      <Variable x:TypeArguments="x:String" Name="logPath" />
      <Variable x:TypeArguments="x:String" Name="smtpPassword" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="settings" Default="[New Dictionary(Of String, String)]" />
      <Variable x:TypeArguments="sd:DataTable" Name="recipients" />
      <Variable x:TypeArguments="sd:DataTable" Name="results" />
      <Variable x:TypeArguments="x:Boolean" Name="dryRun" />
      <Variable x:TypeArguments="x:Int32" Name="sent" />
      <Variable x:TypeArguments="x:Int32" Name="skipped" />
      <Variable x:TypeArguments="x:Int32" Name="failed" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[&quot;Lab06 started&quot;]" />
    <Assign DisplayName="Assign settingsPath">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[settingsPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["Data\settings.csv"]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign recipientsPath">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[recipientsPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["Data\recipients.xlsx"]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign attachmentsFolder">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[attachmentsFolder]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["Data\Attachments"]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign logPath">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[logPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["Data\Results\send_log.xlsx"]</InArgument>
      </Assign.Value>
    </Assign>
    <TryCatch DisplayName="Try Catch: the whole process">
      <TryCatch.Try>
        <Sequence DisplayName="Try">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <If DisplayName="If the old log exists" Condition="[System.IO.File.Exists(logPath)]">
            <If.Then>
              <Sequence DisplayName="Then">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <ui:Delete DisplayName="Delete the old log" Path="[logPath]" />
              </Sequence>
            </If.Then>
          </If>
          <ui:InvokeWorkflowFile DisplayName="Invoke ReadSettings" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\ReadSettings.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_SettingsPath">[settingsPath]</InArgument>
              <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="out_Settings">[settings]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <Assign DisplayName="Dry run unless DryRun is False">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Boolean">[dryRun]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Boolean">[Not (settings.ContainsKey("DryRun") AndAlso settings("DryRun").Trim().ToLower() = "false")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Assign smtpPassword">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[smtpPassword]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[""]</InArgument>
            </Assign.Value>
          </Assign>
          <If DisplayName="If the e-mails are really sent" Condition="[Not dryRun]">
            <If.Then>
              <Sequence DisplayName="Then">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <ui:InputDialog DisplayName="Ask for the SMTP password" Options="{x:Null}" OptionsString="{x:Null}" Title="Send reports by e-mail" IsPassword="True" Label="[&quot;Password of &quot; &amp; settings(&quot;Sender&quot;) &amp; &quot; (SMTP)&quot;]">
                  <ui:InputDialog.Result>
                    <OutArgument x:TypeArguments="x:String">[smtpPassword]</OutArgument>
                  </ui:InputDialog.Result>
                </ui:InputDialog>
                <If DisplayName="Business rule: a password was given" Condition="[smtpPassword Is Nothing OrElse smtpPassword = &quot;&quot;]">
                  <If.Then>
                    <Sequence DisplayName="Then">
                      <sap:WorkflowViewStateService.ViewState>
                        <scg:Dictionary x:TypeArguments="x:String, x:Object">
                          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                        </scg:Dictionary>
                      </sap:WorkflowViewStateService.ViewState>
                      <Throw DisplayName="Throw: no password" Exception="[New BusinessRuleException(&quot;No password was entered, nothing was sent.&quot;)]" />
                    </Sequence>
                  </If.Then>
                </If>
              </Sequence>
            </If.Then>
          </If>
          <ui:InvokeWorkflowFile DisplayName="Invoke ReadRecipients" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\ReadRecipients.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_Path">[recipientsPath]</InArgument>
              <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_Recipients">[recipients]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:InvokeWorkflowFile DisplayName="Invoke SendEmails" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\SendEmails.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="sd:DataTable" x:Key="in_Recipients">[recipients]</InArgument>
              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_Settings">[settings]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Password">[smtpPassword]</InArgument>
              <InArgument x:TypeArguments="x:Boolean" x:Key="in_DryRun">[dryRun]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_AttachmentsFolder">[attachmentsFolder]</InArgument>
              <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_Results">[results]</OutArgument>
              <OutArgument x:TypeArguments="x:Int32" x:Key="out_Sent">[sent]</OutArgument>
              <OutArgument x:TypeArguments="x:Int32" x:Key="out_Skipped">[skipped]</OutArgument>
              <OutArgument x:TypeArguments="x:Int32" x:Key="out_Failed">[failed]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:WriteRange DisplayName="Write Range: the send log" StartingCell="{x:Null}" AddHeaders="True" DataTable="[results]" SheetName="[&quot;Log&quot;]" WorkbookPath="[logPath]" />
          <ui:MessageBox DisplayName="Show the result" Caption="Send reports by e-mail" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" Text="[If(dryRun, &quot;DRY RUN, nothing was sent.&quot; &amp; Environment.NewLine, &quot;&quot;) &amp; &quot;Prepared or sent: &quot; &amp; sent &amp; Environment.NewLine &amp; &quot;Skipped: &quot; &amp; skipped &amp; Environment.NewLine &amp; &quot;Failed: &quot; &amp; failed &amp; Environment.NewLine &amp; &quot;Log: &quot; &amp; logPath]" />
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="ui:BusinessRuleException">
          <ActivityAction x:TypeArguments="ui:BusinessRuleException">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="ui:BusinessRuleException" Name="brex" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Catch BusinessRuleException">
              <sap:WorkflowViewStateService.ViewState>
                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                  <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                </scg:Dictionary>
              </sap:WorkflowViewStateService.ViewState>
              <ui:LogMessage DisplayName="Log the business rule problem" Level="Warn" Message="[&quot;Business rule: &quot; &amp; brex.Message]" />
              <ui:MessageBox DisplayName="Tell the user" Caption="Send reports by e-mail" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" Text="[&quot;Nothing was sent. &quot; &amp; brex.Message]" />
            </Sequence>
          </ActivityAction>
        </Catch>
        <Catch x:TypeArguments="s:Exception">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="ex" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Catch Exception">
              <sap:WorkflowViewStateService.ViewState>
                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                  <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                </scg:Dictionary>
              </sap:WorkflowViewStateService.ViewState>
              <ui:LogMessage DisplayName="Log the system exception" Level="Error" Message="[&quot;System exception: &quot; &amp; ex.Message]" />
              <ui:MessageBox DisplayName="Tell the user" Caption="Send reports by e-mail" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" Text="[&quot;The process stopped: &quot; &amp; ex.Message]" />
              <Rethrow DisplayName="Rethrow" />
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
    <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[&quot;Lab06 finished&quot;]" />
  </Sequence>
</Activity>
