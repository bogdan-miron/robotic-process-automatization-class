  <Sequence DisplayName="Save the results" sap2010:Annotation.AnnotationText="The scraped table (all text) goes to a .csv file, the numbers are summed up in a .txt file. Numbers are read and written with the invariant culture so the result does not depend on the Windows language.">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:List(x:String)" Name="csvLines" Default="[New List(Of String)]" />
      <Variable x:TypeArguments="x:Double" Name="price" />
      <Variable x:TypeArguments="x:Int32" Name="stock" />
      <Variable x:TypeArguments="x:Double" Name="priceSum" />
      <Variable x:TypeArguments="x:Double" Name="stockValue" />
      <Variable x:TypeArguments="x:Double" Name="cheapestPrice" Default="-1" />
      <Variable x:TypeArguments="x:String" Name="cheapestName" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <If DisplayName="Business rule: something to save" Condition="[in_Products.Rows.Count = 0]">
      <If.Then>
        <Sequence DisplayName="Then">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Throw DisplayName="Throw: nothing to save" Exception="[New BusinessRuleException(&quot;There are no products to save&quot;)]" />
        </Sequence>
      </If.Then>
    </If>
    <Assign DisplayName="Create the CSV lines">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(x:String)">[csvLines]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(x:String)">[New List(Of String)]</InArgument>
      </Assign.Value>
    </Assign>
    <InvokeMethod DisplayName="Add the CSV header" MethodName="Add">
      <InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="scg:List(x:String)">[csvLines]</InArgument>
      </InvokeMethod.TargetObject>
      <InArgument x:TypeArguments="x:String">["""SKU"",""Name"",""Category"",""Price"",""Stock"""]</InArgument>
    </InvokeMethod>
    <ui:ForEachRow DisplayName="For each product" ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[in_Products]">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <InvokeMethod DisplayName="Add the CSV line" MethodName="Add">
              <InvokeMethod.TargetObject>
                <InArgument x:TypeArguments="scg:List(x:String)">[csvLines]</InArgument>
              </InvokeMethod.TargetObject>
              <InArgument x:TypeArguments="x:String">["""" &amp; CurrentRow("SKU").ToString().Replace("""", """""") &amp; """" &amp; "," &amp; """" &amp; CurrentRow("Name").ToString().Replace("""", """""") &amp; """" &amp; "," &amp; """" &amp; CurrentRow("Category").ToString().Replace("""", """""") &amp; """" &amp; "," &amp; """" &amp; CurrentRow("Price").ToString().Replace("""", """""") &amp; """" &amp; "," &amp; """" &amp; CurrentRow("Stock").ToString().Replace("""", """""") &amp; """"]</InArgument>
            </InvokeMethod>
            <Assign DisplayName="Price as a number">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Double">[price]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Double">[Double.Parse(CurrentRow("Price").ToString(), System.Globalization.CultureInfo.InvariantCulture)]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Stock as a number">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Int32">[stock]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Int32">[Integer.Parse(CurrentRow("Stock").ToString())]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Assign priceSum">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Double">[priceSum]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Double">[priceSum + price]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Assign stockValue">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Double">[stockValue]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Double">[stockValue + price * stock]</InArgument>
              </Assign.Value>
            </Assign>
            <If DisplayName="If this is the cheapest so far" Condition="[cheapestPrice &lt; 0 OrElse price &lt; cheapestPrice]">
              <If.Then>
                <Sequence DisplayName="Then">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <Assign DisplayName="Assign cheapestPrice">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Double">[cheapestPrice]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Double">[price]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <Assign DisplayName="Assign cheapestName">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[cheapestName]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[CurrentRow("Name").ToString()]</InArgument>
                    </Assign.Value>
                  </Assign>
                </Sequence>
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <ui:WriteTextFile DisplayName="Write the CSV file" FileName="[in_CsvPath]" Text="[String.Join(Environment.NewLine, csvLines)]" />
    <ui:WriteTextFile DisplayName="Write the summary text file" FileName="[in_SummaryPath]" Text="[&quot;Parts catalog scrape&quot; &amp; Environment.NewLine &amp; &quot;Page filters: &quot; &amp; in_FilterText.Replace(&quot;Filters: &quot;, &quot;&quot;) &amp; Environment.NewLine &amp; &quot;Page says: &quot; &amp; in_CountText &amp; Environment.NewLine &amp; &quot;Rows extracted: &quot; &amp; in_Products.Rows.Count &amp; Environment.NewLine &amp; &quot;Average price: &quot; &amp; (priceSum / in_Products.Rows.Count).ToString(&quot;0.00&quot;, System.Globalization.CultureInfo.InvariantCulture) &amp; &quot; EUR&quot; &amp; Environment.NewLine &amp; &quot;Cheapest: &quot; &amp; cheapestName &amp; &quot; (&quot; &amp; cheapestPrice.ToString(&quot;0.00&quot;, System.Globalization.CultureInfo.InvariantCulture) &amp; &quot; EUR)&quot; &amp; Environment.NewLine &amp; &quot;Stock value of the list: &quot; &amp; stockValue.ToString(&quot;0.00&quot;, System.Globalization.CultureInfo.InvariantCulture) &amp; &quot; EUR&quot;]" />
    <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[&quot;Saved &quot; &amp; in_Products.Rows.Count &amp; &quot; products to &quot; &amp; in_CsvPath &amp; &quot; and the summary to &quot; &amp; in_SummaryPath]" />
  </Sequence>
</Activity>
