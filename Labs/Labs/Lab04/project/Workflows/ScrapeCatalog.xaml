  <Sequence DisplayName="Scrape the catalog" sap2010:Annotation.AnnotationText="All the UI work is here. Business rule: no product found. System exception: the page and the rows do not agree.">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="foundCount" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[&quot;Opening &quot; &amp; in_PageUrl]" />
    <uix:NApplicationCard DisplayName="Use Browser Chrome: Parts Catalog" sap2010:Annotation.AnnotationText="Use Browser opens the page (or attaches to it if it is open) and runs the UI activities inside it." AttachMode="ByInstance" InteractionMode="DebuggerApi" ScopeGuid="9cad99f0-9ab5-56ef-81ff-2b7c5e06a4dd" Version="V2">
      <uix:NApplicationCard.Body>
        <ActivityAction x:TypeArguments="x:Object">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Object" Name="WSSessionData" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do Parts Catalog">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <uix:NClick DisplayName="Click 'In stock only'" sap2010:Annotation.AnnotationText="UI input method 1: Click. The page keeps only the products that are in stock." ActivateBefore="True" ClickType="Single" KeyModifiers="None" MouseButton="Left" ScopeIdentifier="9cad99f0-9ab5-56ef-81ff-2b7c5e06a4dd" Version="V3">
              <uix:NClick.Target>
                <uix:TargetAnchorable FullSelectorArgument="&lt;webctrl id='btnStockOnly' tag='BUTTON' /&gt;" Guid="e124ab39-10e1-5430-9911-9b8272cea305" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Parts Catalog' /&gt;" SearchSteps="Selector" Version="V3" Visibility="Interactive" ElementType="Button" />
              </uix:NClick.Target>
            </uix:NClick>
            <uix:NTypeInto DisplayName="Type Into 'Name contains'" sap2010:Annotation.AnnotationText="UI input method 2: Type Into. The field is emptied first, then the text is typed." ActivateBefore="True" ClickBeforeMode="Single" EmptyFieldMode="SingleLine" ScopeIdentifier="9cad99f0-9ab5-56ef-81ff-2b7c5e06a4dd" Text="[in_SearchTerm]" Version="V3">
              <uix:NTypeInto.Target>
                <uix:TargetAnchorable FullSelectorArgument="&lt;webctrl id='searchBox' tag='INPUT' /&gt;" Guid="1062d537-282b-5672-a169-97df48e8e4a9" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Parts Catalog' /&gt;" SearchSteps="Selector" Version="V3" Visibility="Interactive" ElementType="InputBox" />
              </uix:NTypeInto.Target>
            </uix:NTypeInto>
            <uix:NTypeInto DisplayName="Type Into 'Max price'" ActivateBefore="True" ClickBeforeMode="Single" EmptyFieldMode="SingleLine" ScopeIdentifier="9cad99f0-9ab5-56ef-81ff-2b7c5e06a4dd" Text="[in_MaxPrice]" Version="V3">
              <uix:NTypeInto.Target>
                <uix:TargetAnchorable FullSelectorArgument="&lt;webctrl id='maxPrice' tag='INPUT' /&gt;" Guid="e3b0c879-2bb3-538e-81cd-ab97654419ab" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Parts Catalog' /&gt;" SearchSteps="Selector" Version="V3" Visibility="Interactive" ElementType="InputBox" />
              </uix:NTypeInto.Target>
            </uix:NTypeInto>
            <uix:NKeyboardShortcuts DisplayName="Keyboard Shortcuts: Enter" sap2010:Annotation.AnnotationText="UI input method 3: Keyboard Shortcuts. Enter in the price field applies the two filters (same as the Search button)." ActivateBefore="True" ClickBeforeMode="None" Shortcuts="[d(hk)][k(enter)][u(hk)]" Version="V3" />
            <uix:NClick DisplayName="Click 'Sort by price'" ActivateBefore="True" ClickType="Single" KeyModifiers="None" MouseButton="Left" ScopeIdentifier="9cad99f0-9ab5-56ef-81ff-2b7c5e06a4dd" Version="V3">
              <uix:NClick.Target>
                <uix:TargetAnchorable FullSelectorArgument="&lt;webctrl id='btnSortPrice' tag='BUTTON' /&gt;" Guid="604e9bd8-11f4-551a-ba79-ec0670682d5a" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Parts Catalog' /&gt;" SearchSteps="Selector" Version="V3" Visibility="Interactive" ElementType="Button" />
              </uix:NClick.Target>
            </uix:NClick>
            <uix:NGetText DisplayName="Get Text: filters" sap2010:Annotation.AnnotationText="Screen scraping: Get Text reads what the page shows about the active filters." ScopeIdentifier="9cad99f0-9ab5-56ef-81ff-2b7c5e06a4dd" TextString="[out_FilterText]" Version="V3">
              <uix:NGetText.Target>
                <uix:TargetAnchorable FullSelectorArgument="&lt;webctrl id='filterSummary' tag='P' /&gt;" Guid="1b4aabad-7b30-5e60-a281-ee59a37e0965" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Parts Catalog' /&gt;" SearchSteps="Selector" Version="V3" Visibility="Interactive" ElementType="Text" />
              </uix:NGetText.Target>
            </uix:NGetText>
            <uix:NGetText DisplayName="Get Text: product count" ScopeIdentifier="9cad99f0-9ab5-56ef-81ff-2b7c5e06a4dd" TextString="[out_CountText]" Version="V3">
              <uix:NGetText.Target>
                <uix:TargetAnchorable FullSelectorArgument="&lt;webctrl id='resultCount' tag='P' /&gt;" Guid="c3c43aff-b1a4-517e-ab2c-68d48cbc2d12" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Parts Catalog' /&gt;" SearchSteps="Selector" Version="V3" Visibility="Interactive" ElementType="Text" />
              </uix:NGetText.Target>
            </uix:NGetText>
            <Assign DisplayName="Read the number of products">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Int32">[foundCount]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Int32">[CInt(System.Text.RegularExpressions.Regex.Match(out_CountText, "\d+").Value)]</InArgument>
              </Assign.Value>
            </Assign>
            <If DisplayName="If the page shows products" sap2010:Annotation.AnnotationText="With no result row there is nothing to extract, so the table is read only when the count is above 0." Condition="[foundCount &gt; 0]">
              <If.Then>
                <Sequence DisplayName="Then">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <uix:NExtractData DisplayName="Extract Table Data: products" sap2010:Annotation.AnnotationText="Data scraping: the whole result table becomes a DataTable (columns SKU, Name, Category, Price, Stock)." AppendResults="False" DataTable="[out_Products]" ExtractDataSettings="&lt;Table xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xmlns:xsd='http://www.w3.org/2001/XMLSchema' Type='Table' AddCvHeader='true' IsScrollEnabled='false'&gt;&lt;Column xsi:type='DataColumn' ReferenceName='SKU' ReferenceIdx='0' Name='SKU'&gt;&lt;IsValidName&gt;true&lt;/IsValidName&gt;&lt;ValidationErrorMessage /&gt;&lt;IsExtra&gt;false&lt;/IsExtra&gt;&lt;CanExtractSimilar&gt;false&lt;/CanExtractSimilar&gt;&lt;Format xsi:type='TextColumnFormat' /&gt;&lt;/Column&gt;&lt;Column xsi:type='DataColumn' ReferenceName='Name' ReferenceIdx='1' Name='Name'&gt;&lt;IsValidName&gt;true&lt;/IsValidName&gt;&lt;ValidationErrorMessage /&gt;&lt;IsExtra&gt;false&lt;/IsExtra&gt;&lt;CanExtractSimilar&gt;false&lt;/CanExtractSimilar&gt;&lt;Format xsi:type='TextColumnFormat' /&gt;&lt;/Column&gt;&lt;Column xsi:type='DataColumn' ReferenceName='Category' ReferenceIdx='2' Name='Category'&gt;&lt;IsValidName&gt;true&lt;/IsValidName&gt;&lt;ValidationErrorMessage /&gt;&lt;IsExtra&gt;false&lt;/IsExtra&gt;&lt;CanExtractSimilar&gt;false&lt;/CanExtractSimilar&gt;&lt;Format xsi:type='TextColumnFormat' /&gt;&lt;/Column&gt;&lt;Column xsi:type='DataColumn' ReferenceName='Price' ReferenceIdx='3' Name='Price'&gt;&lt;IsValidName&gt;true&lt;/IsValidName&gt;&lt;ValidationErrorMessage /&gt;&lt;IsExtra&gt;false&lt;/IsExtra&gt;&lt;CanExtractSimilar&gt;false&lt;/CanExtractSimilar&gt;&lt;Format xsi:type='TextColumnFormat' /&gt;&lt;/Column&gt;&lt;Column xsi:type='DataColumn' ReferenceName='Stock' ReferenceIdx='4' Name='Stock'&gt;&lt;IsValidName&gt;true&lt;/IsValidName&gt;&lt;ValidationErrorMessage /&gt;&lt;IsExtra&gt;false&lt;/IsExtra&gt;&lt;CanExtractSimilar&gt;false&lt;/CanExtractSimilar&gt;&lt;Format xsi:type='TextColumnFormat' /&gt;&lt;/Column&gt;&lt;/Table&gt;" ExtractMetadata="&lt;extract-table get_columns_name='1' get_empty_columns='1' columns_name_source='Longest'&gt;&lt;column name='SKU' attr='fulltext' /&gt;&lt;column name='Name' attr='fulltext' /&gt;&lt;column name='Category' attr='fulltext' /&gt;&lt;column name='Price' attr='fulltext' /&gt;&lt;column name='Stock' attr='fulltext' /&gt;&lt;/extract-table&gt;" LimitExtractionTo="None" MaximumResults="0" ScopeIdentifier="9cad99f0-9ab5-56ef-81ff-2b7c5e06a4dd" Version="V3">
                    <uix:NExtractData.Target>
                      <uix:TargetAnchorable FullSelectorArgument="&lt;webctrl id='productTable' tag='TABLE' /&gt;" Guid="69a9c32d-8022-53d2-9dcb-ae39a601aaca" ScopeSelectorArgument="&lt;html app='chrome.exe' title='Parts Catalog' /&gt;" SearchSteps="Selector" Version="V3" Visibility="Interactive" />
                    </uix:NExtractData.Target>
                  </uix:NExtractData>
                </Sequence>
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </uix:NApplicationCard.Body>
      <uix:NApplicationCard.TargetApp>
        <uix:TargetApp BrowserType="Chrome" Selector="&lt;html app='chrome.exe' title='Parts Catalog' /&gt;" Title="Parts Catalog" Url="[in_PageUrl]" />
      </uix:NApplicationCard.TargetApp>
    </uix:NApplicationCard>
    <If DisplayName="Business rule: at least one product" Condition="[foundCount = 0]">
      <If.Then>
        <Sequence DisplayName="Then">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Throw DisplayName="Throw: no product found" Exception="[New BusinessRuleException(&quot;No product matches the filters (&quot; &amp; out_FilterText &amp; &quot;)&quot;)]" />
        </Sequence>
      </If.Then>
    </If>
    <If DisplayName="Check: the rows match the count" Condition="[out_Products.Rows.Count &lt;&gt; foundCount]">
      <If.Then>
        <Sequence DisplayName="Then">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Throw DisplayName="Throw: count and rows differ" Exception="[New InvalidOperationException(&quot;The page says &quot; &amp; foundCount &amp; &quot; products but &quot; &amp; out_Products.Rows.Count &amp; &quot; rows were extracted&quot;)]" />
        </Sequence>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[&quot;Scraped &quot; &amp; out_Products.Rows.Count &amp; &quot; products. &quot; &amp; out_FilterText]" />
  </Sequence>
</Activity>
