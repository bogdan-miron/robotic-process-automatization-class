  <Sequence DisplayName="Lab02: Guess the Number (multiple workflows)" sap2010:Annotation.AnnotationText="Main workflow: it only coordinates. The work is done in the invoked workflows.">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="settingsPath" />
      <Variable x:TypeArguments="x:String" Name="scoresPath" />
      <Variable x:TypeArguments="x:String" Name="playerName" />
      <Variable x:TypeArguments="x:String" Name="difficulty" />
      <Variable x:TypeArguments="x:String" Name="answer" />
      <Variable x:TypeArguments="x:String" Name="summary" />
      <Variable x:TypeArguments="s:String[]" Name="levels" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Int32)" Name="ranges" Default="[New Dictionary(Of String, Int32)]" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Int32)" Name="maxAttemptsByLevel" Default="[New Dictionary(Of String, Int32)]" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="log" Default="[New List(Of String)]" />
      <Variable x:TypeArguments="scg:List(x:Int32)" Name="history" Default="[New List(Of Int32)]" />
      <Variable x:TypeArguments="x:Int32" Name="maxNumber" />
      <Variable x:TypeArguments="x:Int32" Name="maxAttempts" />
      <Variable x:TypeArguments="x:Int32" Name="attempts" />
      <Variable x:TypeArguments="x:Int32" Name="secretNumber" />
      <Variable x:TypeArguments="x:Boolean" Name="won" />
      <Variable x:TypeArguments="x:Boolean" Name="playAgain" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[&quot;Lab02 started&quot;]" />
    <Assign DisplayName="Assign settingsPath">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[settingsPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["Data\settings.csv"]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign scoresPath">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[scoresPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["Data\scores.csv"]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:InvokeWorkflowFile DisplayName="Invoke ReadSettings" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\ReadSettings.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_SettingsPath">[settingsPath]</InArgument>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)" x:Key="out_Ranges">[ranges]</OutArgument>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)" x:Key="out_MaxAttempts">[maxAttemptsByLevel]</OutArgument>
        <InOutArgument x:TypeArguments="scg:List(x:String)" x:Key="io_Log">[log]</InOutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <Assign DisplayName="Level names for the drop-down">
      <Assign.To>
        <OutArgument x:TypeArguments="s:String[]">[levels]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="s:String[]">[ranges.Keys.ToArray()]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:InputDialog DisplayName="Ask for the player name" Options="{x:Null}" OptionsString="{x:Null}" Title="Guess the number" IsPassword="False" Label="[&quot;What is your name?&quot;]">
      <ui:InputDialog.Result>
        <OutArgument x:TypeArguments="x:String">[playerName]</OutArgument>
      </ui:InputDialog.Result>
    </ui:InputDialog>
    <If DisplayName="If the name is empty" Condition="[playerName Is Nothing OrElse playerName.Trim() = &quot;&quot;]">
      <If.Then>
        <Sequence DisplayName="Then">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Assign DisplayName="Assign playerName">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[playerName]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">["Player"]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
    </If>
    <Assign DisplayName="Assign playAgain">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Boolean">[playAgain]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
      </Assign.Value>
    </Assign>
    <While DisplayName="While the player wants to play" Condition="[playAgain]">
      <While.Body>
        <Sequence DisplayName="Body">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <ui:InputDialog DisplayName="Choose the level" Options="[levels]" OptionsString="{x:Null}" Title="Guess the number" IsPassword="False" Label="[&quot;Choose a level&quot;]">
            <ui:InputDialog.Result>
              <OutArgument x:TypeArguments="x:String">[difficulty]</OutArgument>
            </ui:InputDialog.Result>
          </ui:InputDialog>
          <If DisplayName="If no valid level was chosen" Condition="[difficulty Is Nothing OrElse Not ranges.ContainsKey(difficulty)]">
            <If.Then>
              <Sequence DisplayName="Then">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <Assign DisplayName="Assign difficulty">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[difficulty]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">[levels(0)]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </If.Then>
          </If>
          <Assign DisplayName="Largest number of the level">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[maxNumber]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[ranges(difficulty)]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign DisplayName="Attempts allowed on the level">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[maxAttempts]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[maxAttemptsByLevel(difficulty)]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:InvokeWorkflowFile DisplayName="Invoke PlayRound" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\PlayRound.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_PlayerName">[playerName]</InArgument>
              <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxNumber">[maxNumber]</InArgument>
              <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxAttempts">[maxAttempts]</InArgument>
              <InOutArgument x:TypeArguments="scg:List(x:Int32)" x:Key="io_History">[history]</InOutArgument>
              <OutArgument x:TypeArguments="x:Int32" x:Key="out_Attempts">[attempts]</OutArgument>
              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Won">[won]</OutArgument>
              <OutArgument x:TypeArguments="x:Int32" x:Key="out_Secret">[secretNumber]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <If DisplayName="If the number was guessed" Condition="[won]">
            <If.Then>
              <Sequence DisplayName="Then">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <ui:MessageBox DisplayName="Message Box" Caption="Guess the number" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" Text="[&quot;Well done!!! You found &quot; &amp; secretNumber &amp; &quot; in &quot; &amp; attempts &amp; &quot; attempts.&quot;]" />
              </Sequence>
            </If.Then>
            <If.Else>
              <Sequence DisplayName="Else">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <ui:MessageBox DisplayName="Message Box" Caption="Guess the number" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" Text="[&quot;Out of attempts. The number was &quot; &amp; secretNumber &amp; &quot;.&quot;]" />
              </Sequence>
            </If.Else>
          </If>
          <ui:InvokeWorkflowFile DisplayName="Invoke SaveScore" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\SaveScore.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_ScoresPath">[scoresPath]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_PlayerName">[playerName]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Level">[difficulty]</InArgument>
              <InArgument x:TypeArguments="x:Int32" x:Key="in_Attempts">[attempts]</InArgument>
              <InArgument x:TypeArguments="x:Boolean" x:Key="in_Won">[won]</InArgument>
              <InOutArgument x:TypeArguments="scg:List(x:String)" x:Key="io_Log">[log]</InOutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:InvokeWorkflowFile DisplayName="Invoke ShowLeaderboard" ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" UnSafe="False" WorkflowFileName="Workflows\ShowLeaderboard.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_ScoresPath">[scoresPath]</InArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_Summary">[summary]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:MessageBox DisplayName="Show the leaderboard" Caption="Guess the number" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" Text="[summary]" />
          <ui:InputDialog DisplayName="Ask to play again" Options="{x:Null}" OptionsString="Yes;No" Title="Guess the number" IsPassword="False" Label="[&quot;Play again?&quot;]">
            <ui:InputDialog.Result>
              <OutArgument x:TypeArguments="x:String">[answer]</OutArgument>
            </ui:InputDialog.Result>
          </ui:InputDialog>
          <Assign DisplayName="Assign playAgain">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Boolean">[playAgain]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Boolean">[answer = "Yes"]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </While.Body>
    </While>
    <ui:ForEach DisplayName="For each log entry" x:TypeArguments="x:String" CurrentIndex="{x:Null}" Values="[log]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="entry" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[entry]" />
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:MessageBox DisplayName="Message Box" Caption="Guess the number" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" Text="[&quot;Thanks for playing, &quot; &amp; playerName &amp; &quot;.&quot;]" />
    <ui:LogMessage DisplayName="Log Message" Level="Info" Message="[&quot;Lab02 finished&quot;]" />
  </Sequence>
</Activity>
