  <Sequence DisplayName="Save the score" sap2010:Annotation.AnnotationText="Writes Data\scores.csv (Write Text File for the header, Append Line for each game).">
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <If DisplayName="If the file does not exist yet" Condition="[Not System.IO.File.Exists(in_ScoresPath)]">
      <If.Then>
        <Sequence DisplayName="Then">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <ui:WriteTextFile DisplayName="Write the header line" FileName="[in_ScoresPath]" Text="[&quot;Date,Player,Level,Attempts,Won&quot; &amp; Environment.NewLine]" />
        </Sequence>
      </If.Then>
    </If>
    <ui:AppendLine DisplayName="Append one line for this game" FileName="[in_ScoresPath]" Text="[DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm&quot;) &amp; &quot;,&quot; &amp; in_PlayerName.Replace(&quot;,&quot;, &quot; &quot;) &amp; &quot;,&quot; &amp; in_Level &amp; &quot;,&quot; &amp; in_Attempts &amp; &quot;,&quot; &amp; in_Won]" />
    <InvokeMethod DisplayName="Write to the log list" MethodName="Add">
      <InvokeMethod.TargetObject>
        <InArgument x:TypeArguments="scg:List(x:String)">[io_Log]</InArgument>
      </InvokeMethod.TargetObject>
      <InArgument x:TypeArguments="x:String">["Saved the score of " &amp; in_PlayerName]</InArgument>
    </InvokeMethod>
  </Sequence>
