  <Sequence DisplayName="Build the leaderboard" sap2010:Annotation.AnnotationText="Reads Data\scores.csv and returns the best attempts per level.">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="content" />
      <Variable x:TypeArguments="s:String[]" Name="lines" />
      <Variable x:TypeArguments="s:String[]" Name="parts" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Int32)" Name="bestAttempts" Default="[New Dictionary(Of String, Int32)]" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Assign DisplayName="Start with an empty summary">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_Summary]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[""]</InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="If the scores file exists" Condition="[System.IO.File.Exists(in_ScoresPath)]">
      <If.Then>
        <Sequence DisplayName="Then">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <ui:ReadTextFile DisplayName="Read the scores file" Content="[content]" FileName="[in_ScoresPath]" />
          <Assign DisplayName="Split the text into lines">
            <Assign.To>
              <OutArgument x:TypeArguments="s:String[]">[lines]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="s:String[]">[content.Split(New String() {Environment.NewLine}, StringSplitOptions.RemoveEmptyEntries)]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:ForEach DisplayName="For each saved game" x:TypeArguments="x:String" CurrentIndex="{x:Null}" Values="[lines]">
            <ui:ForEach.Body>
              <ActivityAction x:TypeArguments="x:String">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="x:String" Name="line" />
                </ActivityAction.Argument>
                <Sequence DisplayName="Body">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <If DisplayName="Skip the header line" Condition="[Not line.StartsWith(&quot;Date&quot;)]">
                    <If.Then>
                      <Sequence DisplayName="Then">
                        <sap:WorkflowViewStateService.ViewState>
                          <scg:Dictionary x:TypeArguments="x:String, x:Object">
                            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                          </scg:Dictionary>
                        </sap:WorkflowViewStateService.ViewState>
                        <Assign DisplayName="Split the line at commas">
                          <Assign.To>
                            <OutArgument x:TypeArguments="s:String[]">[parts]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="s:String[]">[line.Split(","c)]</InArgument>
                          </Assign.Value>
                        </Assign>
                        <If DisplayName="Only won games count" Condition="[parts(4) = &quot;True&quot;]">
                          <If.Then>
                            <Sequence DisplayName="Then">
                              <sap:WorkflowViewStateService.ViewState>
                                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                  <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                                </scg:Dictionary>
                              </sap:WorkflowViewStateService.ViewState>
                              <If DisplayName="If the level has no best yet" Condition="[Not bestAttempts.ContainsKey(parts(2))]">
                                <If.Then>
                                  <Sequence DisplayName="Then">
                                    <sap:WorkflowViewStateService.ViewState>
                                      <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                                      </scg:Dictionary>
                                    </sap:WorkflowViewStateService.ViewState>
                                    <InvokeMethod DisplayName="First win on this level" MethodName="Add">
                                      <InvokeMethod.TargetObject>
                                        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[bestAttempts]</InArgument>
                                      </InvokeMethod.TargetObject>
                                      <InArgument x:TypeArguments="x:String">[parts(2)]</InArgument>
                                      <InArgument x:TypeArguments="x:Int32">[CInt(parts(3))]</InArgument>
                                    </InvokeMethod>
                                  </Sequence>
                                </If.Then>
                                <If.Else>
                                  <Sequence DisplayName="Else">
                                    <sap:WorkflowViewStateService.ViewState>
                                      <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                                      </scg:Dictionary>
                                    </sap:WorkflowViewStateService.ViewState>
                                    <If DisplayName="If fewer attempts than the best" Condition="[CInt(parts(3)) &lt; bestAttempts(parts(2))]">
                                      <If.Then>
                                        <Sequence DisplayName="Then">
                                          <sap:WorkflowViewStateService.ViewState>
                                            <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                                            </scg:Dictionary>
                                          </sap:WorkflowViewStateService.ViewState>
                                          <InvokeMethod DisplayName="Remove the old best" MethodName="Remove">
                                            <InvokeMethod.TargetObject>
                                              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[bestAttempts]</InArgument>
                                            </InvokeMethod.TargetObject>
                                            <InArgument x:TypeArguments="x:String">[parts(2)]</InArgument>
                                          </InvokeMethod>
                                          <InvokeMethod DisplayName="Store the new best" MethodName="Add">
                                            <InvokeMethod.TargetObject>
                                              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Int32)">[bestAttempts]</InArgument>
                                            </InvokeMethod.TargetObject>
                                            <InArgument x:TypeArguments="x:String">[parts(2)]</InArgument>
                                            <InArgument x:TypeArguments="x:Int32">[CInt(parts(3))]</InArgument>
                                          </InvokeMethod>
                                        </Sequence>
                                      </If.Then>
                                    </If>
                                  </Sequence>
                                </If.Else>
                              </If>
                            </Sequence>
                          </If.Then>
                        </If>
                      </Sequence>
                    </If.Then>
                  </If>
                </Sequence>
              </ActivityAction>
            </ui:ForEach.Body>
          </ui:ForEach>
          <Assign DisplayName="Assign out_Summary">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[out_Summary]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">["Games saved: " &amp; (lines.Length - 1) &amp; Environment.NewLine]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:ForEach DisplayName="For each level with a win" x:TypeArguments="scg:KeyValuePair(x:String, x:Int32)" CurrentIndex="{x:Null}" Values="[bestAttempts]">
            <ui:ForEach.Body>
              <ActivityAction x:TypeArguments="scg:KeyValuePair(x:String, x:Int32)">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="scg:KeyValuePair(x:String, x:Int32)" Name="entry" />
                </ActivityAction.Argument>
                <Sequence DisplayName="Body">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <Assign DisplayName="Assign out_Summary">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[out_Summary]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">[out_Summary &amp; entry.Key &amp; ": best " &amp; entry.Value &amp; " attempts" &amp; Environment.NewLine]</InArgument>
                    </Assign.Value>
                  </Assign>
                </Sequence>
              </ActivityAction>
            </ui:ForEach.Body>
          </ui:ForEach>
          <If DisplayName="If nobody has won yet" Condition="[bestAttempts.Count = 0]">
            <If.Then>
              <Sequence DisplayName="Then">
                <sap:WorkflowViewStateService.ViewState>
                  <scg:Dictionary x:TypeArguments="x:String, x:Object">
                    <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  </scg:Dictionary>
                </sap:WorkflowViewStateService.ViewState>
                <Assign DisplayName="Assign out_Summary">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[out_Summary]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">[out_Summary &amp; "No won games yet."]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </If.Then>
          </If>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Assign DisplayName="Assign out_Summary">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[out_Summary]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">["No scores saved yet."]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>
