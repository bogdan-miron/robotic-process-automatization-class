  <Sequence DisplayName="Describe the guesses" sap2010:Annotation.AnnotationText="Custom activity 2. Builds a sentence with all the guesses of a round and the closest one.">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="best" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <If DisplayName="If there are no guesses" Condition="[History.Count = 0]">
      <If.Then>
        <Sequence DisplayName="Then">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Assign DisplayName="Assign Text">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[Text]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">["No guesses were made."]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>
          <Assign DisplayName="Start with the first guess">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[best]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[History(0)]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:ForEach DisplayName="For each guess" x:TypeArguments="x:Int32" CurrentIndex="{x:Null}" Values="[History]">
            <ui:ForEach.Body>
              <ActivityAction x:TypeArguments="x:Int32">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="x:Int32" Name="g" />
                </ActivityAction.Argument>
                <Sequence DisplayName="Body">
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
                  <If DisplayName="If this guess is closer to the number" Condition="[Math.Abs(g - Secret) &lt; Math.Abs(best - Secret)]">
                    <If.Then>
                      <Sequence DisplayName="Then">
                        <sap:WorkflowViewStateService.ViewState>
                          <scg:Dictionary x:TypeArguments="x:String, x:Object">
                            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                          </scg:Dictionary>
                        </sap:WorkflowViewStateService.ViewState>
                        <Assign DisplayName="Closer guess found">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:Int32">[best]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:Int32">[g]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </Sequence>
                    </If.Then>
                  </If>
                </Sequence>
              </ActivityAction>
            </ui:ForEach.Body>
          </ui:ForEach>
          <Assign DisplayName="Assign Text">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[Text]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">["Your guesses: " &amp; String.Join(", ", History) &amp; ". The closest one was " &amp; best &amp; "."]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>
